{
  "$schema": "https://btca.dev/btca.schema.json",
  "providerTimeoutMs": 300000,
  "resources": [
    {
      "type": "git",
      "name": "svelte",
      "url": "https://github.com/sveltejs/svelte.dev",
      "branch": "main",
      "searchPath": "apps/svelte.dev",
      "specialNotes": "Svelte docs website. Focus on content directory for markdown docs."
    },
    {
      "type": "git",
      "name": "tailwind",
      "url": "https://github.com/tailwindlabs/tailwindcss.com",
      "branch": "main",
      "searchPath": "src/docs"
    },
    {
      "type": "git",
      "name": "vite",
      "url": "https://github.com/vitejs/vite",
      "branch": "main",
      "searchPath": "docs",
      "specialNotes": "Vite documentation and examples."
    },
    {
      "type": "git",
      "name": "typescript",
      "url": "https://github.com/microsoft/TypeScript",
      "branch": "main",
      "searchPath": "doc",
      "specialNotes": "TypeScript language specification and documentation."
    },
    {
      "type": "git",
      "name": "cloudflareWorkers",
      "url": "https://github.com/cloudflare/workers-sdk",
      "branch": "main",
      "searchPath": "docs",
      "specialNotes": "Cloudflare Workers documentation and examples."
    },
    {
      "type": "git",
      "name": "opencode",
      "url": "https://github.com/anomalyco/opencode",
      "branch": "dev"
    }
  ],
  "model": "claude-haiku-4-5",
  "provider": "opencode"
}